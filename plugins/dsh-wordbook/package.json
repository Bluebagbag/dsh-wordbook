{
  "name": "dsh-wordbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "背单词：左侧栏入口，自己录入词表、本地保存，用 DSH 当前模型聊天式讲解，并可一键生成包含这些词的英语阅读理解题。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": ["dsh", "dsh-plugin", "vocabulary", "wordbook", "english"],
  "license": "MIT"
}
